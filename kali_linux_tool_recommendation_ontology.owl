#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#Advanced
KaliLinuxTools:Advanced rdf:type owl:NamedIndividual ,
                                 KaliLinuxTools:UserLevel ;
                        rdfs:comment "Use this tool responsibly and only in authorized environments."@en ;
                        rdfs:label "Advanced"@en .


###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#Aircrackng
KaliLinuxTools:Aircrackng rdf:type owl:NamedIndividual ,
                                   KaliLinuxTools:WirelessAttackTool ;
                          KaliLinuxTools:SuggestedToolChain KaliLinuxTools:Airmonng ;
                          KaliLinuxTools:belongsToCategory KaliLinuxTools:CrackingWireless ;
                          KaliLinuxTools:isFollowedBy KaliLinuxTools:Airmonng ;
                          KaliLinuxTools:isUsedFor KaliLinuxTools:TestWiFiSecurity ;
                          KaliLinuxTools:requiresSkillLevel KaliLinuxTools:Advanced ;
                          KaliLinuxTools:hasCommand "aircrack-ng capture.cap" ;
                          KaliLinuxTools:hasDescription "Cracks WEP/WPA keys from captured packets" ;
                          KaliLinuxTools:hasEthicalNote "\"Crack keys only for networks you own or are authorised to test.\"" ;
                          KaliLinuxTools:hasLegalNote "\"Prohibited on unauthorised Wi-Fi infrastructure.\"" ;
                          KaliLinuxTools:preferredPhase "Exploit (Wireless)" ;
                          KaliLinuxTools:riskLevel "High" ;
                          rdfs:comment "Cracks WEP/WPA keys from captured packets"@en ;
                          rdfs:label "Aircracking"@en .


###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#Airmonng
KaliLinuxTools:Airmonng rdf:type owl:NamedIndividual ,
                                 KaliLinuxTools:WirelessAttackTool ;
                        KaliLinuxTools:belongsToCategory KaliLinuxTools:CrackingWireless ;
                        KaliLinuxTools:isUsedFor KaliLinuxTools:TestWiFiSecurity ;
                        KaliLinuxTools:requiresSkillLevel KaliLinuxTools:Advanced ;
                        KaliLinuxTools:hasCommand "airmon-ng start wlan0" ;
                        KaliLinuxTools:hasDescription "Enables monitor mode on wireless interfaces" ;
                        KaliLinuxTools:hasEthicalNote "\"Switch interfaces to monitor mode only on authorised wireless networks.\"" ;
                        KaliLinuxTools:hasLegalNote "\"Capturing Wi-Fi traffic without consent is unlawful.\"" ;
                        KaliLinuxTools:preferredPhase "Recon (Wireless)" ;
                        KaliLinuxTools:riskLevel "Medium" ;
                        rdfs:comment "Enables monitor mode"@en ;
                        rdfs:label "Airmonng"@en .


###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#AnalyzeArtifacts
KaliLinuxTools:AnalyzeArtifacts rdf:type owl:NamedIndividual ,
