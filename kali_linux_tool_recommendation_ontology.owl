@prefix : <http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix KaliLinuxTools: <http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#> .
@base <http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#> .

<http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools> rdf:type owl:Ontology ;
                                                                     rdfs:comment "A SEMANTICALLY DEVELOPED KNOWLEDGE-BASED SYSTEM FOR DEPLOYING KALI LINUX TOOLS’’"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#SuggestedToolChain
KaliLinuxTools:SuggestedToolChain rdf:type owl:ObjectProperty ;
                                  rdfs:domain KaliLinuxTools:Tool ;
                                  rdfs:range KaliLinuxTools:Tool .


###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#belongsToCategory
KaliLinuxTools:belongsToCategory rdf:type owl:ObjectProperty ;
                                 rdfs:domain KaliLinuxTools:Tool ;
                                 rdfs:range KaliLinuxTools:Category .


###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#isFollowedBy
KaliLinuxTools:isFollowedBy rdf:type owl:ObjectProperty ;
                            rdfs:domain KaliLinuxTools:Tool ;
                            rdfs:range KaliLinuxTools:Tool .


###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#isUsedFor
KaliLinuxTools:isUsedFor rdf:type owl:ObjectProperty ;
                         rdfs:domain KaliLinuxTools:Tool ;
                         rdfs:range KaliLinuxTools:Task .


###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#requiresSkillLevel
KaliLinuxTools:requiresSkillLevel rdf:type owl:ObjectProperty ;
                                  rdfs:domain KaliLinuxTools:Tool ;
                                  rdfs:range KaliLinuxTools:UserLevel .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#hasCommand
KaliLinuxTools:hasCommand rdf:type owl:DatatypeProperty ;
                          rdfs:domain KaliLinuxTools:Tool ;
                          rdfs:range rdfs:Literal .


###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#hasDescription
KaliLinuxTools:hasDescription rdf:type owl:DatatypeProperty ;
                              rdfs:domain KaliLinuxTools:Tool ;
                              rdfs:range rdfs:Literal .


###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#hasEthicalNote
KaliLinuxTools:hasEthicalNote rdf:type owl:DatatypeProperty .


###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#hasLegalNote
KaliLinuxTools:hasLegalNote rdf:type owl:DatatypeProperty ;
                            rdfs:subPropertyOf owl:topDataProperty .


###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#preferredPhase
KaliLinuxTools:preferredPhase rdf:type owl:DatatypeProperty ;
                              rdfs:subPropertyOf owl:topDataProperty .


###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#riskLevel
KaliLinuxTools:riskLevel rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf owl:topDataProperty .


###  http://www.w3.org/2002/07/owl#topDataProperty
owl:topDataProperty rdfs:comment "data properties connect individuals to literal values such as text, numbers, or commands"@en .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#AdvancedTool
KaliLinuxTools:AdvancedTool rdf:type owl:Class ;
                            rdfs:subClassOf KaliLinuxTools:UserLevel ;
                            rdfs:comment "The ontology and taxonomy are designed strictly for lawful penetration testing and cybersecurity training. All examples assume that tools are used within authorised environments"@en .


