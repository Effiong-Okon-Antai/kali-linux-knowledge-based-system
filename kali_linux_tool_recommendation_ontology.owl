                              rdfs:label "AnalyzeTraffic"@en .


###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#Armitage
KaliLinuxTools:Armitage rdf:type owl:NamedIndividual ,
                                 KaliLinuxTools:ExploitationTool ;
                        KaliLinuxTools:belongsToCategory KaliLinuxTools:ExploitationPassword ;
                        KaliLinuxTools:isUsedFor KaliLinuxTools:ExploitVulneraability ;
                        KaliLinuxTools:requiresSkillLevel KaliLinuxTools:Advanced ;
                        KaliLinuxTools:hasCommand "armitage" ;
                        KaliLinuxTools:hasDescription "GUI front-end for Metasploit" ;
                        KaliLinuxTools:hasEthicalNote "\"Coordinate attacks only in authorised test environments.\"" ;
                        KaliLinuxTools:hasLegalNote "\"Team-based exploitation requires written client approval.\"" ;
                        KaliLinuxTools:preferredPhase "Exploit / Post-Exploit" ;
                        KaliLinuxTools:riskLevel "High" ;
                        rdfs:comment "GUI front-end for Metasploit"@en ;
                        rdfs:label "Armitage"@en .


