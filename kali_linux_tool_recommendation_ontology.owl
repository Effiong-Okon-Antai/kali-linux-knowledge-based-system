                                rdfs:label "CrackingWireless"@en .


###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#Dradis
KaliLinuxTools:Dradis rdf:type owl:NamedIndividual ,
                               KaliLinuxTools:ReportingTool ;
                      KaliLinuxTools:belongsToCategory KaliLinuxTools:InformationCollaboration ;
                      KaliLinuxTools:isUsedFor KaliLinuxTools:ReportFindingTools ;
                      KaliLinuxTools:requiresSkillLevel KaliLinuxTools:Beginner ;
                      KaliLinuxTools:hasCommand "dradis" ;
                      KaliLinuxTools:hasDescription "Reporting and collaboration platform" ;
                      KaliLinuxTools:hasEthicalNote "\"Share findings only within authorised teams.\"" ;
                      KaliLinuxTools:hasLegalNote "\"Respect confidentiality agreements when reporting vulnerabilities.\"" ;
                      KaliLinuxTools:preferredPhase "Reporting" ;
                      KaliLinuxTools:riskLevel "Low" ;
                      rdfs:comment "Reporting and collaboration platform"@en ;
                      rdfs:label "Dradis"@en .


###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#Ettercap
KaliLinuxTools:Ettercap rdf:type owl:NamedIndividual ,
                                 KaliLinuxTools:SniffingSpoofingTool ;
                        KaliLinuxTools:belongsToCategory KaliLinuxTools:ManInTheMiddle ;
                        KaliLinuxTools:isUsedFor KaliLinuxTools:AnalyzeTraffic ;
                        KaliLinuxTools:requiresSkillLevel KaliLinuxTools:Advanced ;
                        KaliLinuxTools:hasCommand "dradis" ;
                        KaliLinuxTools:hasDescription "Reporting and collaboration platform" ;
                        KaliLinuxTools:hasEthicalNote "\"Use only in controlled environments; MITM attacks affect all traffic.\"" ;
                        KaliLinuxTools:hasLegalNote "\"Interception without consent is unlawful in most jurisdictions.\"" ;
                        KaliLinuxTools:preferredPhase "Exploit (Network Manipulation)" ;
                        KaliLinuxTools:riskLevel "High" ;
                        rdfs:comment "MITM attacks and sniffing"@en ;
                        rdfs:label "Ettercap"@en .


