KaliLinuxTools:AttacksMITM rdf:type owl:NamedIndividual ,
                                    KaliLinuxTools:Category .


###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#AttacksVulnerability
KaliLinuxTools:AttacksVulnerability rdf:type owl:NamedIndividual ,
                                             KaliLinuxTools:Category .


###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#Autopsy
KaliLinuxTools:Autopsy rdf:type owl:NamedIndividual ,
                                KaliLinuxTools:ForensicsTool ;
                       KaliLinuxTools:belongsToCategory KaliLinuxTools:ScanningForensics ;
                       KaliLinuxTools:isUsedFor KaliLinuxTools:AnalyzeArtifacts ;
                       KaliLinuxTools:requiresSkillLevel KaliLinuxTools:Beginner ;
                       KaliLinuxTools:hasCommand "GUI-based forensic analysis platform" ,
                                                 "autopsy" ;
                       KaliLinuxTools:hasEthicalNote "hasEthicalNote: \"Limit analysis to evidence you are permitted to handle.\"" ;
                       KaliLinuxTools:hasLegalNote "\"Ensure compliance with digital evidence handling regulations.\"" ;
                       KaliLinuxTools:preferredPhase "Forensics" ;
                       KaliLinuxTools:riskLevel "Medium" ;
                       rdfs:comment "GUI-based forensic analysis platform"@en ;
                       rdfs:label "Autopsy"@en .


