KaliLinuxTools:Beginner rdf:type owl:NamedIndividual ,
                                 KaliLinuxTools:UserLevel ;
                        rdfs:comment "Use this tool responsibly and only in authorized environments."@en ;
                        rdfs:label "Beginner"@en .


###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#Binwalk
KaliLinuxTools:Binwalk rdf:type owl:NamedIndividual ,
                                KaliLinuxTools:ForensicsTool ;
                       KaliLinuxTools:isUsedFor KaliLinuxTools:AnalyzeFirmware ;
                       KaliLinuxTools:requiresSkillLevel KaliLinuxTools:Advanced ;
                       KaliLinuxTools:hasCommand "Firmware analysis tool" ,
                                                 "binwalk firmware.bin" ;
                       KaliLinuxTools:hasEthicalNote "\"Analyse only firmware images you are authorised to test.\"" ;
                       KaliLinuxTools:hasLegalNote "\"Respect licensing and proprietary rights in firmware.\"" ;
                       KaliLinuxTools:preferredPhase "Reverse Engineering" ;
                       KaliLinuxTools:riskLevel "Low" ;
                       rdfs:comment "Firmware analysis tool"@en ;
                       rdfs:label "Binwalk"@en .


###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#BurpSuite
KaliLinuxTools:BurpSuite rdf:type owl:NamedIndividual ,
                                  KaliLinuxTools:ExploitationTool ;
                         KaliLinuxTools:belongsToCategory KaliLinuxTools:ExploitationWeb ;
                         KaliLinuxTools:isUsedFor KaliLinuxTools:ExploitVulneraability ;
                         KaliLinuxTools:requiresSkillLevel KaliLinuxTools:Intermediate ;
                         KaliLinuxTools:hasCommand "burpsuite" ;
                         KaliLinuxTools:hasDescription "Web vulnerability scanner and proxy tool" ;
                         KaliLinuxTools:hasEthicalNote "\"Intercept traffic only from authorised applications.\"" ;
                         KaliLinuxTools:hasLegalNote "\"Unauthorised interception of HTTP/S traffic is unlawful.\"" ;
                         KaliLinuxTools:preferredPhase "Vulnerability Analysis" ;
                         KaliLinuxTools:riskLevel "Medium" ;
                         rdfs:comment "Web vulnerability scanner and proxy tool"@en ;
                         rdfs:label "BurpSuite"@en .


