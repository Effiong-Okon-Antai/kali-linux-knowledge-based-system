###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#Hashcat
KaliLinuxTools:Hashcat rdf:type owl:NamedIndividual ,
                                KaliLinuxTools:PasswordCrackingTool ;
                       KaliLinuxTools:belongsToCategory KaliLinuxTools:CrackPassWord ;
                       KaliLinuxTools:isUsedFor KaliLinuxTools:CrackPassWord ;
                       KaliLinuxTools:requiresSkillLevel KaliLinuxTools:Advanced ;
                       KaliLinuxTools:hasCommand "hashcat -m 0 -a 0 hashes.txt wordlist.txt" ;
                       KaliLinuxTools:hasDescription "Advanced GPU-based password cracker" ;
                       KaliLinuxTools:hasEthicalNote "\"Use only for recovering passwords on systems and data you are authorised to test or own.\"" ;
                       KaliLinuxTools:hasLegalNote "\"Unlawful password cracking on external or unauthorised systems is a criminal offence." ;
                       KaliLinuxTools:preferredPhase "Exploit (Password Cracking / Credential Recovery)" ;
                       KaliLinuxTools:riskLevel "High" ;
                       rdfs:comment "\"An advanced GPU/CPU-based password recovery utility supporting multiple algorithm\""@en ;
                       rdfs:label "Hashcat"@en .


###  http://www.semanticweb.org/milli/ontologies/2025/6/KaliLinuxTools#Hydra
KaliLinuxTools:Hydra rdf:type owl:NamedIndividual ,
                              KaliLinuxTools:PasswordCrackingTool ;
                     KaliLinuxTools:belongsToCategory KaliLinuxTools:CrackingPassword ;
                     KaliLinuxTools:isUsedFor KaliLinuxTools:CrackPassWord ;
                     KaliLinuxTools:requiresSkillLevel KaliLinuxTools:Advanced ;
                     KaliLinuxTools:hasCommand "hydra -l admin -P rockyou.txt ssh://192.168.1.10" ;
                     KaliLinuxTools:hasDescription "Performs dictionary attacks on logins" ;
                     KaliLinuxTools:hasEthicalNote "\"Use brute-force testing only on systems and accounts you are authorised to assess.\"" ;
                     KaliLinuxTools:hasLegalNote "\"Password cracking attempts without consent are unlawful.\"" ;
                     KaliLinuxTools:preferredPhase "Exploit (Credential Testing)" ;
                     KaliLinuxTools:riskLevel "High" ;
                     rdfs:comment "\"A parallelised login cracker that supports numerous protocols including FTP, SSH\""@en ;
                     rdfs:label "Hydra"@en .


